# =============================================================================
# CRM IMMO PRO X — Variables d'environnement
# Copier ce fichier vers .env.local et remplir les valeurs
# =============================================================================

# --- Supabase / PostgreSQL ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."   # Server-side only — NEVER expose to client

# --- Meta / WhatsApp / Facebook ---
FACEBOOK_APP_SECRET=""
FACEBOOK_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Security ---
ENCRYPTION_SECRET=""            # Min 32 chars — for API key encryption at rest
CRON_SECRET=""                  # Bearer token for CRON endpoints
SUPABASE_WEBHOOK_SECRET=""     # Bearer token for Supabase Auth webhooks

# --- AI ---
ANTHROPIC_API_KEY=""

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# --- Sentry (Error Tracking) ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""            # For source maps upload
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Seed ---
SUPER_ADMIN_SUPABASE_ID=""     # Supabase Auth user ID for the Super Admin account
